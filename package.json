{
  "name": "wait-group-promise",
  "version": "1.0.0",
  "description": "A promise-based implementation of Go's WaitGroup for Node.js, with timeouts and typed errors.",
  "keywords": [
    "waitgroup",
    "wait-group",
    "wait",
    "group",
    "golang",
    "go",
    "synchronization",
    "concurrency",
    "promise",
    "typescript",
    "node"
  ],
  "license": "MIT",
  "author": "Zignd <zignd.igor@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zignd/wait-group-promise.git"
  },
  "bugs": {
    "url": "https://github.com/zignd/wait-group-promise/issues"
  },
  "homepage": "https://github.com/zignd/wait-group-promise#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "clean": "rm -rf dist coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint && attw --pack .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:package",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
